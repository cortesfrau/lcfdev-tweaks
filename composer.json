{
    "name": "cortesfrau/lcfdev-tweaks",
    "description": "A lightweight plugin to disable WordPress features your site does not need, improving performance and hardening security through configurable settings.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Lluis Cortes",
            "homepage": "https://github.com/cortesfrau"
        }
    ],
    "homepage": "https://github.com/cortesfrau/lcfdev-tweaks",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "LcfDev\\Tweaks\\": "src/"
        }
    },
    "config": {
        "autoloader-suffix": "LcfDevTweaks",
        "sort-packages": true
    }
}
